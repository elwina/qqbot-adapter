[Unit]
Description=plply QQ adapter v2 (gateway + event spool + API relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/qqbot-adapter-v2
ExecStart=/root/qqbot-adapter-v2/adapter -config config.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
